--[[
    PERSISTENCE SYSTEM
    Re-apply hooks if they're restored
]]
VoidlineBypass.MonitorAndMaintain = function()
    task.spawn(function()
        while VoidlineBypass.Settings.Persistent do
            task.wait(5)
            
            -- Check if our hooks are still active
            local needsRehook = false
            
            -- Check detection function
            for i, v in getgc(true) do
                if type(v) == "table" then
                    local detected = rawget(v, "Detected")
                    if detected and detected == VoidlineBypass.OriginalFunctions.Detected then
                        needsRehook = true
                        break
                    end
                end
            end
            
            if needsRehook and VoidlineBypass.Settings.DebugMode then
                warn("[Voidline] Re-hooking detected functions...")
                VoidlineBypass.HookDetection()
            end
        end
    end)
end

--[[
    CLEANUP FUNCTION
    Restore original functions
]]
VoidlineBypass.Cleanup = function()
    if VoidlineBypass.Settings.DebugMode then
        warn("[Voidline] Cleaning up hooks...")
    end
    
    -- Disconnect all connections
    for _, connection in pairs(VoidlineBypass.HookedFunctions) do
        if type(connection) == "userdata" and connection.Disconnect then
            pcall(connection.Disconnect, connection)
        end
    end
    
    -- Restore original functions
    for funcName, original in pairs(VoidlineBypass.OriginalFunctions) do
        if original and type(original) == "function" then
            if hookfunction then
                pcall(hookfunction, _G[funcName], original)
            end
        end
    end
    
    VoidlineBypass.HookedFunctions = {}
    VoidlineBypass.OriginalFunctions = {}
    
    if VoidlineBypass.Settings.DebugMode then
        warn("[Voidline] Cleanup complete")
    end
end

--[[
    AUTO-EXECUTE WITH SAFETY
]]
local success, err = pcall(function()
    VoidlineBypass.Execute()
    VoidlineBypass.MonitorAndMaintain()
end)

if not success then
    warn("[Voidline] Bypass error: " .. tostring(err))
end

-- Return interface for manual control
return VoidlineBypass
