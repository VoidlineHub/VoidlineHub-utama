VoidlineBypass.HookCoreFunctions = function()
    local coreFunctions = {
        "Disconnect",   -- v_u_32
        "Kick",         -- v_u_36
        "Process",      -- v_u_2.Process
        "Variables",    -- v_u_38
        "Anti",         -- v_u_37
        "Detectors"     -- Detection system
    }
    
    -- tempat deteksi scan 
    local function findAdonisModule(name)
        local players = game:GetService("Players")
        local player = players.LocalPlayer
        if not player then return nil end
        
        -- Check PlayerGui
        local playerGui = player:FindFirstChild("PlayerGui")
        if playerGui then
            for _, gui in pairs(playerGui:GetDescendants()) do
                if gui.Name == name and gui:IsA("ModuleScript") then
                    return gui
                end
            end
        end
        
        -- Check workspace
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj.Name == name and obj:IsA("ModuleScript") then
                return obj
            end
        end
        
        return nil
    end
    
    -- Debugger ,boleh di otak atik.Moal baleggg
    if debug and debug.info then
        VoidlineBypass.OriginalFunctions.debug_info = debug.info
        local hook; hook = hookfunction(debug.info, function(func, what)
            -- Check if this is Adonis trying to inspect our hooks
            for _, hooked in pairs(VoidlineBypass.HookedFunctions) do
                if func == hooked then
                    if VoidlineBypass.Settings.DebugMode then
                        warn("[Voidline] Stack trace inspection blocked")
                    end
                    -- Return fake info or yield
                    return "Hooked function", "C", 0, {}, {}, {}, "voidline_bypass"
                end
            end
            return VoidlineBypass.OriginalFunctions.debug_info(func, what)
        end)
    end
    
    return true
end

-- Antitemper bypass
VoidlineBypass.BypassTamperProtection = function()
    -- Hook name change detection
    local script = script or getfenv().script
    if script then
        local originalName = script.Name
        local nameChanged = script.Changed
        
        if nameChanged then
            local connection = nameChanged:Connect(function(property)
                if property == "Name" then
                    if VoidlineBypass.Settings.DebugMode then
                        warn("[Voidline] Name change detected, restoring...")
                    end
                    -- Allow Adonis to change name but prevent crash
                    task.wait(0.1)
                    if script.Name ~= originalName then
                        script.Name = originalName
                    end
                end
            end)
            table.insert(VoidlineBypass.HookedFunctions, connection)
        end
    end
    
    -- Prevent Archivable checks
    if script and script.Changed then
        local connection = script.Changed:Connect(function(property)
            if property == "Archivable" then
                script.Archivable = false  -- Keep it false as Adonis expects
            end
        end)
        table.insert(VoidlineBypass.HookedFunctions, connection)
    end
    
    -- Hook checkcaller if exists
    if checkcaller then
        VoidlineBypass.OriginalFunctions.checkcaller = checkcaller
        local hook; hook = hookfunction(checkcaller, function()
            return true  -- Always return true to fake script context
        end)
        table.insert(VoidlineBypass.HookedFunctions, hook)
    end
end

-- absen part 2
VoidlineBypass.DisableDetectors = function()
    local detectorsToDisable = {
        "Speed",
        "AntiAntiIdle", 
        "HumanoidState",
        "AntiCoreGui",
        "MainDetection"
    }
    
    -- Method 1: Find and nullify detector functions
    for i, v in getgc(true) do
        if type(v) == "table" and rawget(v, "AddDetector") then
            local addDetector = rawget(v, "AddDetector")
            if type(addDetector) == "function" then
                -- Hook AddDetector to block new detectors
                VoidlineBypass.OriginalFunctions.AddDetector = addDetector
                local hook; hook = hookfunction(addDetector, function(name, func)
                    if VoidlineBypass.Settings.DebugMode then
                        warn("[Voidline] Detector blocked: " .. tostring(name))
                    end
                    -- Return dummy connection
                    return {
                        Disconnect = function() end,
                        Connected = true
                    }
                end)
                table.insert(VoidlineBypass.HookedFunctions, hook)
            end
        end
    end
    
    -- Method 2: Find running detector loops
    for i, v in getrenv() do
        if type(v) == "table" and v.__type == "Loop" then
            local stop = rawget(v, "Stop")
            if type(stop) == "function" then
                pcall(stop)  -- Try to stop the loop
            end
        end
    end
    
    return true
end

-- gatau fungsi nya (dari A.I)
VoidlineBypass.BypassLogSystem = function()
    local logService = game:GetService("LogService")
    if logService then
        -- Clear existing messages
        pcall(function()
            for i = 1, 100 do
                logService.MessageOut:ClearAllChildren()
            end
        end)
        
        -- Hook message output
        if logService.MessageOut then
            local messageAdded = logService.MessageOut.ChildAdded
            if messageAdded then
                local connection = messageAdded:Connect(function(msg)
                    -- Filter out bypass-related messages
                    if msg:IsA("Message") and msg.Text then
                        local text = msg.Text:lower()
                        local blockedPatterns = {
                            "voidline", "bypass", "hook", 
                            "detected", "exploit", "infinite yield"
                        }
                        
                        for _, pattern in pairs(blockedPatterns) do
                            if text:find(pattern) then
                                task.wait(0)
                                msg:Destroy()
                                break
                            end
                        end
                    end
                end)
                table.insert(VoidlineBypass.HookedFunctions, connection)
            end
        end
    end
end

-- metatable hama
VoidlineBypass.BypassMetatableHooks = function()
    -- Check for proxy objects
    local proxies = {}
    
    for i, v in getgc(true) do
        if type(v) == "userdata" then
            local mt = getmetatable(v)
            if mt and rawget(mt, "__metatable") == "The metatable is locked" then
                table.insert(proxies, {object = v, metatable = mt})
            end
        end
    end
    
    -- Hook metatable methods
    for _, proxy in pairs(proxies) do
        local mt = proxy.metatable
        
        -- Replace dangerous metamethods
        local metamethods = {
            "__index", "__newindex", "__tostring", "__unm",
            "__add", "__sub", "__mul", "__div", "__mod",
            "__pow", "__len"
        }
        
        for _, mm in pairs(metamethods) do
            local original = rawget(mt, mm)
            if type(original) == "function" then
                rawset(mt, mm, function(...)
                    if VoidlineBypass.Settings.DebugMode then
                        warn("[Voidline] Metamethod blocked: " .. mm)
                    end
                    -- Return safe values
                    if mm == "__index" then return nil end
                    if mm == "__tostring" then return "Voidline Protected" end
                    if mm:find("__add") or mm:find("__sub") or mm:find("__mul") then
                        return 0
                    end
                    return nil
                end)
            end
        end
    end
    
    return #proxies > 0
end

