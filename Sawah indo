    Desc = "Move to selected world location",
    Icon = "map-pin",
    Callback = function()
        local char = lp.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local target = worldLocations[_G.SelectedWorldTP]
            if target then char.HumanoidRootPart.CFrame = target end
        end
    end
})

-- ==========================================
-- [[ 🌾 SECTION: FARM TELEPORT ]]
-- ==========================================
local FarmTPSection = TeleportTab:Section({ Title = "Farm Area Teleport" })

FarmTPSection:Dropdown({
    Title = "Select Farm Number",
    Desc = "Choose farm area from 1 to 32",
    Values = farmNames,
    Value = _G.SelectedFarmTP,
    Callback = function(option) _G.SelectedFarmTP = option end
})

FarmTPSection:Button({
    Title = "Teleport to Farm",
    Desc = "Move to the specific farming plot",
    Icon = "leaf",
    Callback = function()
        local char = lp.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            -- Ambil angka dari string "Farm Area 1" -> "1"
            local farmNum = string.match(_G.SelectedFarmTP, "%d+") 
            local farmPath = workspace:FindFirstChild("AreaTanamBesar32")
            
            if farmPath then
                local targetFarm = farmPath:FindFirstChild(farmNum)
                if targetFarm and targetFarm:IsA("BasePart") then
                    -- TP ke atas kebun (biar gak kejebak di dalem tanah)
                    char.HumanoidRootPart.CFrame = targetFarm.CFrame * CFrame.new(0, 3, 0)
                elseif targetFarm and targetFarm:IsA("Model") then
                    -- Kalau kebunnya berbentuk model, cari PrimaryPart-nya
                    char.HumanoidRootPart.CFrame = targetFarm:GetModelCFrame() * CFrame.new(0, 3, 0)
                end
            end
        end
    end
})
