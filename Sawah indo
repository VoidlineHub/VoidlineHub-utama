local WindUI = loadstring(game:HttpGet('https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua'))()

-- [[ 2. VARIABEL & REMOTES ]] --
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lp = game.Players.LocalPlayer
local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TutorialRemotes")

local RequestShop = RemotesFolder:WaitForChild("RequestShop")
local RequestSell = RemotesFolder:WaitForChild("RequestSell")
local PlantCropRemote = RemotesFolder:WaitForChild("PlantCrop")

-- Data Config
local seedOptions = {"Bibit Padi", "Bibit Jagung", "Bibit Tomat", "Bibit Terong", "Bibit Strawberry", "Bibit Sawit", "Bibit Durian"}
local itemNames = {"Padi", "Jagung", "Tomat", "Terong", "Strawberry", "Sawit", "Durian"}

-- States
_G.ShopSelected = "Bibit Padi"
_G.EquipSelected = "Bibit Padi"
_G.BuyAmount = 1
_G.AutoEquip = false
_G.AutoPlant = false
_G.AutoCollect = false
_G.SelectedWorldTP = "Merchant"
_G.SelectedFarmTP = "1"
_G.WebhookURL = ""         -- Tempat simpen link Discord
_G.WebhookEnabled = false  -- Status On/Off Webhook
_G.HideUsername = false    -- Status Blur Username
local StartTime = os.time() 

-- [[ WEBHOOK LOGIC ONLY - AROEL STYLE ]] --
local lp = game.Players.LocalPlayer
local stats = lp:FindFirstChild("leaderstats")

-- 1. Data Pemain & Status
local money = stats and stats:FindFirstChild("Money") and stats.Money.Value or 0
local level = stats and stats:FindFirstChild("Level") and stats.Level.Value or 0
local username = _G.HideUsername and "||" .. lp.Name .. "||" or lp.Name

-- 2. Scan Inventory
local items = {}
for _, v in pairs(lp.Backpack:GetChildren()) do
    if v:IsA("Tool") then table.insert(items, v.Name) end
end
local itemList = #items > 0 and table.concat(items, "\n") or "None"

-- 3. Farm Time Calculation
local diff = os.time() - StartTime
local hours = math.floor(diff / 3600)
local mins = math.floor((diff % 3600) / 60)
local secs = diff % 60
local runningTime = string.format("%02d:%02d:%02d", hours, mins, secs)

-- 4. Format Payload (Tanpa Emoji, Persis Screenshot)
local data = {
    ["embeds"] = {{
        ["title"] = "Cycle Completed",
        ["color"] = 0xFFFFFF, -- Putih/Neutral
        ["fields"] = {
            {["name"] = "Username", ["value"] = username, ["inline"] = false},
            {["name"] = "Level", ["value"] = tostring(level), ["inline"] = false},
            {["name"] = "Current Money", ["value"] = "RP. " .. tostring(money), ["inline"] = false},
            {["name"] = "Items in Inventory", ["value"] = itemList, ["inline"] = false},
            {["name"] = "Running Time", ["value"] = runningTime, ["inline"] = false}
        },
        ["footer"] = {["text"] = "VoidlineHub System"},
        ["timestamp"] = os.date("!Y-%m-%dT%H:%M:%SZ")
    }}
}

-- 5. Request Execution (Safe Version)
local req = syn and syn.request or http_request or request
if req then
    -- Cek dulu URL-nya ada isinya gak, biar gak error "Invalid URL"
    if _G.WebhookURL and _G.WebhookURL ~= "" and _G.WebhookURL:find("http") then
        req({
            Url = _G.WebhookURL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = game:GetService("HttpService"):JSONEncode(data)
        })
    else
        -- Notif biar lu tau kalo URL-nya belum diisi/salah
        warn("VoidlineHub: Webhook URL is empty or invalid!")
    end
end


