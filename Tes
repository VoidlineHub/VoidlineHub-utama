local PosA = Vector3.new(-853.855, 4.181, -629.521)
local PosB = Vector3.new(3776.853, 12.801, -601.395)

local function StartShuttle()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local seat = hum and hum.SeatPart
    
    if not seat then return end
    local vehicle = seat.Parent

    -- [[ 1. EKSEKUSI FOLDER STOPPER ]] --
    task.spawn(function()
        local folderTarget = workspace:FindFirstChild("STOPPER") or vehicle:FindFirstChild("STOPPER", true)
        if folderTarget then
            folderTarget:Destroy()
        end
    end)

    -- [[ 2. LOGIKA DETEKSI KENDARAAN ]] --
    local isCar = vehicle:FindFirstChild("A-Chassis Tune", true) or vehicle:FindFirstChild("Car", true)
    local isBike = vehicle:FindFirstChild("Tuner", true) and vehicle.Tuner:FindFirstChild("Interface", true) and vehicle.Tuner.Interface:FindFirstChild("Bike")

    if not isCar or isBike then return end

    _G.AutofarmMobil = true
    
    -- [[ 3. AKTIFKAN BLACKSCREEN SAAT START ]] --
    if SetBlackScreen then
        SetBlackScreen(true)
    end

    local primary = vehicle.PrimaryPart or seat
    local values = vehicle:FindFirstChild("Values", true)

    -- Bypass Safety
    task.spawn(function()
        while _G.AutofarmMobil do
            getgenv().OS = 0
            getgenv().Clock = 999
            RunService.Heartbeat:Wait()
        end
    end)

    -- Movement Loop
    task.spawn(function()
        while _G.AutofarmMobil do
            if not hum.SeatPart or hum.SeatPart.Parent ~= vehicle then
                _G.AutofarmMobil = false
                if SetBlackScreen then SetBlackScreen(false) end -- Matiin pas turun
                break
            end

            primary.CFrame = CFrame.lookAt(PosA, PosB)
            primary.AssemblyLinearVelocity = Vector3.zero
            task.wait(0.5)

            local distance = (PosA - PosB).Magnitude
            local traveled = 0
            
            while traveled < distance and _G.AutofarmMobil do
                local dt = RunService.Heartbeat:Wait()
                local currentSpeed = 230
                local distLeft = distance - traveled
                
                if distLeft < 100 then
                    currentSpeed = math.clamp(currentSpeed * (distLeft / 100), 30, 280)
                end
                
                local speedStuds = currentSpeed / 0.28
                traveled = traveled + (speedStuds * dt)
                
                local nextPos = PosA:Lerp(PosB, math.min(traveled / distance, 1))
                primary.CFrame = CFrame.lookAt(nextPos, PosB)
                primary.AssemblyLinearVelocity = primary.CFrame.lookVector * currentSpeed
                
                if values then
                    if values:FindFirstChild("Velocity") then values.Velocity.Value = primary.AssemblyLinearVelocity end
                    if values:FindFirstChild("IsOn") then values.IsOn.Value = true end
                end

                for _, v in pairs(vehicle:GetDescendants()) do
                    if v:IsA("BasePart") then v.CanCollide = false end
                end
                primary.CanCollide = true
            end

            if _G.AutofarmMobil then
                primary.AssemblyLinearVelocity = Vector3.zero
                task.wait(1.5)
            end
        end
        -- [[ 4. MATIKAN BLACKSCREEN SAAT STOP ]] --
        if SetBlackScreen then
            SetBlackScreen(false)
        end
    end)
end

