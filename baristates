local function handleMinigame()
    local gui = PlayerGui:FindFirstChild("BaristaGUI")
    local mini = gui and gui:FindFirstChild("MinigameFrame")
    if not mini or not mini.Visible then return end

    isWorking = true
    
    pcall(function()
        local target = mini:WaitForChild("BackgroundBar"):WaitForChild("TargetZone")
        target.Size = UDim2.new(1.8, 0, 1.8, 0)
        target.Position = UDim2.new(-0.4, 0, -0.4, 0)
        target.BackgroundTransparency = 1
    end)

    -- Tunggu sampe minigame selesai
    repeat 
        task.wait(0.5) 
    until not mini.Visible or not _G.AutoFarmBarista

    task.wait(0.5)

    -- JALAN KE REGISTER (KASIR)
    autoWalk(registerPart.Position)
    
    -- Loop klik register sampe berhasil (Prompt ilang)
    local regPrompt = registerPart:FindFirstChild("RegisterPrompt")
    local retry = 0
    repeat
        if regPrompt and regPrompt.Enabled then
            safeClick(regPrompt)
        end
        task.wait(0.5)
        retry = retry + 1
    until not regPrompt or not regPrompt.Enabled or retry > 5 or not _G.AutoFarmBarista
    
    -- BALIK KE MESIN
    autoWalk(machinePart.Position)
    isWorking = false
end

