-- SETTING & TOGGLE
_G.QurbanAutoFarm = true -- Ubah ke false jika ingin mematikan

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- Mengambil Remotes
local QurbanRemotes = ReplicatedStorage:WaitForChild("EventAsset"):WaitForChild("QurbanRemotes")
local StartLoadingMinigame = QurbanRemotes:WaitForChild("StartLoadingMinigame")
local PromptInput = QurbanRemotes:WaitForChild("PromptInput")
local DestinationRevealed = QurbanRemotes:WaitForChild("DestinationRevealed")

-- Koordinat Sapi Spawn (Sesuai CFrame permintaanmu)
local koordinatAwal = CFrame.new(-3386.31543, -79.0189896, -23828.9395, 0, 0, 1, 0, -1, 0, 1, 0, 0)

-- Status Pengaman agar tidak konflik antar fungsi
local sedangMengurusSapi = false

-- Fungsi helper untuk notifikasi (bisa disesuaikan dengan UI game-mu)
local function kirimNotif(pesan)
    print("[Qurban System]: " .. pesan)
end

-- FUNGSI OTOMATIS KEMBALI KE SPAWN SAPI
local function autoLoadSapiSpawn(modelTruk)
    if modelTruk and modelTruk:IsA("Model") then
        -- Pindahkan truk beserta pemainnya langsung kembali ke koordinat sapi spawn
        modelTruk:PivotTo(koordinatAwal)
        kirimNotif("Autofarm: Memindahkan Truk kembali ke Sapi Spawn agar area ke-load!")
        task.wait(1.5) -- Waktu tunggu agar map me-load dengan sempurna
        sedangMengurusSapi = false -- Membuka kunci agar karakter bisa mulai nyari sapi lagi
    end
end

--- =============================================================
--- LOGIKA OTOMATIS SAAT SELESAI NGANTER (DELIVERY LOGIC)
--- =============================================================
DestinationRevealed.OnClientEvent:Connect(function(data)
    if _G.QurbanAutoFarm then
        kirimNotif("Rute pengantaran terdeteksi! Memproses pengantaran otomatis...")
        
        -- Cari Truk yang sedang dikendarai pemain
        local karakter = LocalPlayer.Character
        local humanoid = karakter and karakter:FindFirstChildOfClass("Humanoid")
        
        if humanoid and humanoid.SeatPart then
            local truk = humanoid.SeatPart:FindFirstAncestorOfClass("Model")
            
            if truk then
                -- Jeda sedikit simulasi perjalanan/proses klaim hadiah di tempat tujuan jika ada
                task.wait(1.0) 
                
                -- Jalankan fungsi teleport balik setelah beres nganter
                autoLoadSapiSpawn(truk)
            end
        else
            -- Jika pemain entah bagaimana terpisah dari truknya, teleport karakternya saja
            local rootPart = karakter and karakter:FindFirstChild("HumanoidRootPart")
            if rootPart then
                rootPart.CFrame = koordinatAwal
                task.wait(1.5)
                sedangMengurusSapi = false
            end
        end
    end
end)

--- =============================================================
--- FEATURE BYPASS: AUTO ANSWER MINIGAME (0.5s RHYTHM)
--- =============================================================
StartLoadingMinigame.OnClientEvent:Connect(function(data)
    if _G.QurbanAutoFarm then
        sedangMengurusSapi = true
        task.wait(0.5) -- Jeda sebelum menjawab minigame
        
        if data and data.sequence then
            for index, promptData in ipairs(data.sequence) do
                local jawaban = nil
                
                if promptData.type == "TAP" then
                    jawaban = promptData.key
                elseif promptData.type == "SEQUENCE" then
                    jawaban = promptData.sequence 
                elseif promptData.type == "MASH" then
                    jawaban = promptData.targetCount 
                end
                
                PromptInput:FireServer({
                    ["promptIndex"] = index,
                    ["input"] = jawaban
                })
                
                task.wait(0.5) -- Jeda antar tombol/prompt dalam game
            end
        end
        
        -- Jeda setelah game selesai agar data tersinkronisasi ke server
        task.wait(0.5)
    end
end)

--- =============================================================
--- FITUR 1: TELEPORT KE SAPI (DETEKSI DEEP-SCAN MUTASI)
--- =============================================================
task.spawn(function()
    -- Teleportasi awal saat pertama kali script dijalankan
    if _G.QurbanAutoFarm then
        local karakter = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local rootPart = karakter:WaitForChild("HumanoidRootPart", 5)
        if rootPart then
            rootPart.CFrame = koordinatAwal
            task.wait(2.0)
        end
    end

    -- Loop Pencarian Sapi
    while task.wait(0.5) do
        if _G.QurbanAutoFarm and not sedangMengurusSapi then
            local karakter = LocalPlayer.Character
            local rootPart = karakter and karakter:FindFirstChild("HumanoidRootPart")
            local humanoid = karakter and karakter:FindFirstChildOfClass("Humanoid")
            
            -- Hanya bekerja jika sedang tidak duduk di truk
            if rootPart and humanoid and not humanoid.SeatPart then
                local targetSapi = nil
                local prioritasMutasi = false
                
                -- Scan seluruh objek di workspace
                for _, obj in ipairs(workspace:GetChildren()) do
                    if string.sub(obj.Name, 1, 4) == "Cow_" and obj:IsA("Model") then
                        local prompt = obj:FindFirstChild("LoadPrompt", true)
                        
                        if prompt and prompt.Enabled then
                            -- PERBAIKAN: Menggunakan pencarian mendalam (deep scan) true untuk mendeteksi penanda mutasi
                            local apakahMutasi = obj:FindFirstChild("_MutationBaseSA", true)
                            
                            if apakahMutasi then
                                targetSapi = obj
                                prioritasMutasi = true
                                break -- Langsung keluar loop jika mutasi ditemukan
                            elseif not targetSapi then
                                targetSapi = obj -- Simpan sapi biasa sebagai cadangan jika mutasi belum ada
                            end
                        end
                    end
                end
                
                -- Eksekusi Teleportasi ke Sapi
                if targetSapi then
                    local promptSapi = targetSapi:FindFirstChild("LoadPrompt", true)
                    if promptSapi then
                        sedangMengurusSapi = true -- Kunci agar tidak berpindah target saat eksekusi dimulai
                        
                        rootPart.CFrame = targetSapi:GetPivot() * CFrame.new(0, 2, 2)
                        task.wait(0.5) -- Jeda 0.5 detik yang kamu inginkan
                        
                        fireproximityprompt(promptSapi)
                        
                        -- Pengaman Anti Stuck: Membuka kunci otomatis jika dalam 12 detik gagal ke-load
                        task.delay(12, function()
                            if sedangMengurusSapi and (not targetSapi or not targetSapi.Parent or not promptSapi.Enabled) then
                                local cekHumanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                                -- Jika ternyata dia tidak naik truk, kita buka kuncinya biar cari sapi lagi
                                if cekHumanoid and not cekHumanoid.SeatPart then
                                    sedangMengurusSapi = false
                                end
                            end
                        end)
                    end
                end
            end
        end
    end
end)

