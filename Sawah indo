FarmTPSection:Button({
    Title = "Teleport to Farm",
    Desc = "Move directly to the AreaTanam plot",
    Icon = "leaf",
    Callback = function()
        local char = lp.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            -- 1. Ambil angka dari dropdown (misal dari "Farm Area 2" dapet "2")
            local farmNum = string.match(_G.SelectedFarmTP, "%d+") 
            
            -- 2. Gabungin kata "AreaTanam" sama angkanya (jadi "AreaTanam2")
            local targetName = "AreaTanam" .. farmNum
            
            -- 3. Cari objek dengan nama lengkap tersebut di Workspace
            local targetFarm = workspace:FindFirstChild(targetName)
            
            if targetFarm then
                -- Logic TP (Cek Part atau Model)
                local pos = (targetFarm:IsA("Model") and (targetFarm.PrimaryPart and targetFarm.PrimaryPart.CFrame or targetFarm:GetModelCFrame())) or targetFarm.CFrame
                
                char.HumanoidRootPart.CFrame = pos * CFrame.new(0, 5, 0)
                
                WindUI:Notify({
                    Title = "Teleport",
                    Content = "Arrived at " .. targetName,
                    Duration = 2
                })
            else
                -- Kalau masih kaga ketemu, munculin nama yang dicari biar lu tau salahnya dimana
                WindUI:Notify({
                    Title = "Error",
                    Content = "Object '" .. targetName .. "' not found in Workspace!",
                    Duration = 3
                })
            end
        end
    end
})

