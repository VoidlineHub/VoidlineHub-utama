-- --- SECTION 1: BUY SEEDS ---
local BuySeedSection = MainTab:Section({ Title = "Market System" })

BuySeedSection:Dropdown({
    Title = "Select Seed Type",
    Desc = "Choose which seed you want to purchase",
    Values = seedOptions,
    Value = "Bibit Padi",
    Callback = function(option) _G.ShopSelected = option end
})

BuySeedSection:Input({
    Title = "Purchase Amount",
    Placeholder = "Example: 31",
    Callback = function(val) _G.BuyAmount = tonumber(val) or 1 end
})

BuySeedSection:Button({
    Title = "Buy Seeds Now",
    Desc = "Execute purchase for selected seeds",
    Callback = function() RequestShop:InvokeServer("BUY", _G.ShopSelected, _G.BuyAmount) end
})

-- --- SECTION 2: AUTO EQUIP ---
local AutoEquipSection = MainTab:Section({ Title = "Auto Equip" })

AutoEquipSection:Dropdown({
    Title = "Select Seed to Equip",
    Desc = "Tool will be automatically equipped from backpack",
    Values = seedOptions,
    Value = "Bibit Padi",
    Callback = function(option) _G.EquipSelected = option end
})

AutoEquipSection:Toggle({
    Title = "Auto Equip",
    Desc = "Enable smart tool equipment system",
    Callback = function(state)
        _G.AutoEquip = state
        task.spawn(function()
            while _G.AutoEquip do
                local char = lp.Character
                if char and char:FindFirstChild("Humanoid") then
                    local toolInBackpack = nil
                    for _, tool in pairs(lp.Backpack:GetChildren()) do
                        if string.find(tool.Name, _G.EquipSelected) then toolInBackpack = tool break end
                    end
                    local isHolding = false
                    for _, tool in pairs(char:GetChildren()) do
                        if tool:IsA("Tool") and string.find(tool.Name, _G.EquipSelected) then isHolding = true break end
                    end
                    if toolInBackpack and not isHolding then char.Humanoid:EquipTool(toolInBackpack) end
                end
                task.wait(0.5)
            end
        end)
    end
})

-- --- SECTION 3: AUTOMATION ---
local FarmSection = MainTab:Section({ Title = "Farming Automation" })

FarmSection:Toggle({
    Title = "Auto Plant",
    Desc = "Automatically plant seeds based on player position",
    Callback = function(state)
        _G.AutoPlant = state
        task.spawn(function()
            while _G.AutoPlant do
                local char = lp.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local p = char.HumanoidRootPart.Position - Vector3.new(0, 3, 0)
                    PlantCropRemote:FireServer(vector.create(p.X, p.Y, p.Z))
                end
                task.wait(0.2)
            end
        end)
    end
})

FarmSection:Toggle({
    Title = "Auto Collect plant",
    Desc = "Harvest all nearby ready-to-pick crops",
    Callback = function(state)
        _G.AutoCollect = state
        task.spawn(function()
            while _G.AutoCollect do
                local crops = workspace:FindFirstChild("ActiveCrops")
                if crops then
                    for _, crop in pairs(crops:GetChildren()) do
                        if not _G.AutoCollect then break end
                        local prompt = crop:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt then fireproximityprompt(prompt) end
                    end
                end
                task.wait(0.5)
            end
        end)
    end
})

-- --- SECTION 4: SELLING ---
local SellingSection = MainTab:Section({ Title = "Selling System" })

SellingSection:Button({
