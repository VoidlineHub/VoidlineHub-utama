-- [[ 3. SECTION TELEPORT ]] --
local TPSection = TeleportTab:Section({ Title = "World Teleport" })

TPSection:Dropdown({
    Title = "Select Destination",
    Desc = "Choose a location to teleport",
    Values = locationNames,
    Value = "Pemandian",
    Callback = function(option)
        _G.SelectedTP = option
    end
})

TPSection:Button({
    Title = "Teleport Now",
    Desc = "Instantly move to the selected location",
    Icon = "map-pin",
    Callback = function()
        local char = game.Players.LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local targetCFrame = locations[_G.SelectedTP]
            if targetCFrame then
                char.HumanoidRootPart.CFrame = targetCFrame
                
                WindUI:Notify({
                    Title = "Teleport Success",
                    Content = "Arrived at " .. _G.SelectedTP,
                    Duration = 2
                })
            end
        end
    end
})
