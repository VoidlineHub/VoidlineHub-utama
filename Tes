        if not v then
            local char = LP.Character
            if char then
                local head = char:FindFirstChild("Head")
                if head then 
                    for _, gui in pairs(head:GetChildren()) do 
                        if gui:IsA("BillboardGui") then gui.Enabled = true end 
                    end 
                end
            end
        end

        WindUI:Notify({
            Title = "Stealth Mode",
            Content = "Hide Name: " .. (v and "Enabled" or "Disabled"),
            Duration = 2
        })
    end
})


SettingsTab:Toggle({
    Title = "Hide Char",
    Value = _G.HideCharEnabled,
    Callback = function(v)
        _G.HideCharEnabled = v
        
        -- Logic instant buat balikin karakter pas toggle OFF
        if not v then
            local char = LP.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do 
                    if part:IsA("BasePart") or part:IsA("Decal") then 
                        -- Jangan buat HumanoidRootPart jadi kelihatan (biasanya emang transparan)
                        if part.Name ~= "HumanoidRootPart" then
                            part.Transparency = 0 
                        end
                    end 
                end
            end
        end

        WindUI:Notify({
            Title = "Stealth Mode",
            Content = "Hide Character: " .. (v and "Enabled" or "Disabled"),
            Duration = 2
        })
    end
})


