-- Ambil list file buat Dropdown
local function GetConfigs()
    local files = {}
    for _, file in pairs(listfiles("")) do
        if file:sub(-5) == ".json" then
            table.insert(files, file:gsub(".json", ""))
        end
    end
    return files
end

local SelectedLoad = ""
ConfigSection:Dropdown({
    Title = "Select Config",
    Desc = "Choose a file to load.",
    Options = GetConfigs(),
    Callback = function(v) SelectedLoad = v end
})

ConfigSection:Button({
    Title = "Load Selected Config",
    Desc = "Apply settings from the chosen file.",
    Callback = function()
        local file = SelectedLoad .. ".json"
        if isfile(file) then
            local data = HttpService:JSONDecode(readfile(file))
            -- Apply variables
            _G.ShopSelected = data.ShopSelected
            _G.WalkSpeed = data.WalkSpeed
            _G.JumpPower = data.JumpPower
            _G.SpoofName = data.SpoofName
            -- Re-apply current mods
            if lp.Character and lp.Character:FindFirstChild("Humanoid") then
                lp.Character.Humanoid.WalkSpeed = _G.WalkSpeed
                lp.Character.Humanoid.JumpPower = _G.JumpPower
            end
            print("Loaded: " .. SelectedLoad)
        end
    end
})
