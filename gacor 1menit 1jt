-- // --- FUNGSI UTAMA (PIVOT TWEEN) --- //
local function PivotTween(targetPos)
    local seat = LP.Character and LP.Character.Humanoid.SeatPart
    if not seat or not _G.AutoRaceEnabled then return end
    
    local model = seat.Parent
    local startCF = model:GetPivot()
    local targetCF = CFrame.new(targetPos) * Rotasi_Kanan
    local jarak = (model:GetPivot().Position - targetPos).Magnitude
    
    local currentSpeed = _G.AutoRaceSpeed
    local durasi = jarak / currentSpeed

    local tweenValue = Instance.new("CFrameValue")
    tweenValue.Value = startCF
    seat.Anchored = false

    local updateConn = tweenValue.Changed:Connect(function()
        if not _G.AutoRaceEnabled then return end
        model:PivotTo(tweenValue.Value)
        seat.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        seat.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end)

    local info = TweenInfo.new(durasi, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(tweenValue, info, {Value = targetCF})
    
    tween:Play()
    
    while tween.PlaybackState == Enum.PlaybackState.Playing do
        if not _G.AutoRaceEnabled then 
            tween:Cancel() 
            break 
        end
        task.wait()
    end

    updateConn:Disconnect()
    tweenValue:Destroy()
end

