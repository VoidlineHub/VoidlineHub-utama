        if not v then
            local char = LP.Character
            if char then
                local head = char:FindFirstChild("Head")
                if head then 
                    for _, gui in pairs(head:GetChildren()) do 
                        if gui:IsA("BillboardGui") then gui.Enabled = true end 
                    end 
                end
            end
        end

        WindUI:Notify({
