-- // 3. LOGIC & FORMATTING
local function FormatNumber(value)
    local formatted = tostring(math.floor(value))
    while true do  
        local k
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", '%1,%2')
        if k == 0 then break end
    end
    return formatted
end

local activeSeconds = 0
task.spawn(function()
    while task.wait(1) do
        -- UI ikut toggle
        ScreenGui.Enabled = _G.PanelStats
        
        if _G.AutoRaceEnabled then 
            activeSeconds = activeSeconds + 1 
            
            -- Update Stats
            local h, m, s = math.floor(activeSeconds/3600), math.floor((activeSeconds%3600)/60), activeSeconds%60
            SessionVal.Text = string.format("%02d:%02d:%02d", h, m, s)
            
            if RPValue then
                local current = RPValue.Value
                local earned = current - StartMoney
                CurrentVal.Text = "RP " .. FormatNumber(current)
                EarnedVal.Text  = "RP " .. FormatNumber(earned)
                
                -- Pendapatan per second
                local eps = earned / activeSeconds
                EPSVal.Text = string.format("%.2f RP/s", eps)
            end
        end
    end
end)

-- // 4. SMOOTH DRAG LOGIC
local dragging, dragInput, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

